---
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pop-Plants</title>
    <style>
        body { font-family: system-ui, sans-serif; max-width: 800px; margin: 0 auto; padding: 2rem; background: #f4f7f4; color: #2d3748; }
        h1 { color: #2e7d32; text-align: center; }
        .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1.5rem; margin-top: 2rem; }
        .card { background: white; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 5px rgba(0,0,0,0.1); text-align: center; padding: 1rem; }
        .card img { max-width: 100%; height: 180px; object-fit: cover; border-radius: 4px; }
        .card h2 { font-size: 1.1rem; margin: 0.5rem 0; color: #1b5e20; }
    </style>
</head>
<body>
    <h1>Pop-Plants Houseplant Guides</h1>
    <div class="grid">
        {posts.map(plant => (
            <div class="card">
                <img src={plant.data.image} alt={plant.data.title} />
                <h2>{plant.data.title}</h2>
            </div>
        ))}
    </div>
</body>
